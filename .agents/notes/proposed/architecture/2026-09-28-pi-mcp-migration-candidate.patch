index 00000000..8e5f1748
--- /dev/null
+++ b/packages/harness-pi/src/mcp-adapter.ts
@@ -0,0 +1,338 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { createHash } from 'node:crypto';
+import {
+  createEventBus,
+  type ExtensionAPI,
+  type ToolDefinition,
+} from '@earendil-works/pi-coding-agent';
+import type { McpImageBinding } from '@molly/shared/embedded-harness';
+import {
+  createHostManagedMcpAdapter,
+  type HostManagedMcpServer,
+  type HostManagedMcpToolCall,
+} from 'pi-mcp-adapter/host-managed';
+import { MCP_TOOL_APPROVAL_REQUEST_EVENT, type McpToolApprovalRequest } from 'pi-mcp-adapter/types';
+import { createCancellationDeliveryTransport } from './mcp-cancellation';
+import { waitForApproval, type ToolApproval } from './approved-tools';
+import { bindMcpImageTool } from './mcp-image-binding';
+import { mcpToolName, imageBindingDescription } from './mcp-tool-definition';
+import { McpToolFailure, resolveMcpContent } from './mcp-content';
+import type { defineMcpTools } from './mcp-bridge';
+import type { OperationResourceRead } from './tool-operation-journal';
+
+type Scope = {
+  toolCallId: string;
+  serverName: string;
+  rawToolName: string;
+  origin: 'direct' | 'resource';
+  failure?: Error;
+};
+
+const safeCodes = new Set([
+  'harness_mcp_connection_changed',
+  'harness_mcp_schema_changed',
+  'harness_permission_denied',
+  'harness_mcp_arguments_invalid',
+  'harness_mcp_image_arguments_invalid',
+  'harness_mcp_result_unsupported',
+  'harness_mcp_result_limit',
+  'harness_mcp_resource_mismatch',
+  'harness_mcp_resource_read_unavailable',
+  'harness_mcp_image_resource_import_unavailable',
+  'harness_mcp_tool_failed',
+  'harness_mcp_outcome_unknown',
+]);
+
+function safeFailure(error: unknown, cancelled = false): Error {
+  if (cancelled) return new Error('harness_cancelled');
+  if (error instanceof McpToolFailure) return new McpToolFailure(error.message);
+  return new Error(
+    error instanceof Error && safeCodes.has(error.message)
+      ? error.message
+      : 'harness_mcp_tool_failed'
+  );
+}
+
+export async function connectAdapterMcpServers(
+  servers: Record<string, HostManagedMcpServer & { imageBinding?: McpImageBinding }>,
+  input: {
+    approve: ToolApproval;
+    dispatch: Parameters<typeof defineMcpTools>[0]['dispatch'];
+    signal?: AbortSignal;
+    imageImportAvailable?: boolean;
+  }
+) {
+  const lifetime = new AbortController();
+  const scopes = new AsyncLocalStorage<Scope>();
+  const events = createEventBus();
+  const transports: Array<ReturnType<typeof createCancellationDeliveryTransport>> = [];
+  const definitions = new Map<
+    string,
+    {
+      serverName: string;
+      rawToolName: string;
+      label: string;
+      description: string;
+      image: ReturnType<typeof bindMcpImageTool>;
+    }
+  >();
+  const tools: ToolDefinition[] = [];
+  let closed = false;
+  let closing: Promise<void> | undefined;
+
+  events.on(MCP_TOOL_APPROVAL_REQUEST_EVENT, (value) => {
+    const request = value as McpToolApprovalRequest;
+    const scope = scopes.getStore();
+    request.claim(async () => {
+      if (
+        closed ||
+        !scope ||
+        scope.serverName !== request.serverName ||
+        scope.rawToolName !== request.originalToolName ||
+        scope.origin !== request.origin
+      )
+        return 'deny';
+      const allowed = await waitForApproval(
+        input.approve({
+          toolCallId: scope.toolCallId,
+          name: `${scope.serverName}/${scope.origin === 'resource' ? 'resources/read' : scope.rawToolName}`,
+          arguments: structuredClone(request.args),
+          signal: request.signal,
+        }),
+        request.signal
+      );
+      return allowed && !closed && !request.signal?.aborted ? 'allow_once' : 'deny';
+    });
+  });
+
+  const adapter = createHostManagedMcpAdapter({
+    requestTimeoutMs: 210_000,
+    catalogTimeoutMs: 30_000,
+    resourceTimeoutMs: 30_000,
+    catalogToolLimit: 256,
+    revalidateCatalog: true,
+    outputGuard: false,
+    servers: Object.fromEntries(
+      Object.entries(servers).map(([serverName, server]) => [
+        serverName,
+        {
+          ...server,
+          async createTransport(context) {
+            const transport = createCancellationDeliveryTransport(
+              await server.createTransport(context)
+            );
+            transports.push(transport);
+            return transport;
+          },
+        } satisfies HostManagedMcpServer,
+      ])
+    ),
+    toolName(serverName, tool) {
+      const name = mcpToolName(serverName, tool.name);
+      const image = bindMcpImageTool(tool, servers[serverName]?.imageBinding);
+      definitions.set(name, {
+        serverName,
+        rawToolName: tool.name,
+        label: tool.title ?? tool.name,
+        description: `[MCP ${serverName}] ${tool.description ?? tool.name}${imageBindingDescription(image, input.imageImportAvailable)}`,
+        image,
+      });
+      return name;
+    },
+    async onToolCall(call) {
+      const scope = scopes.getStore();
+      const definition = definitions.get(call.toolName);
+      if (
+        !scope ||
+        scope.origin !== 'direct' ||
+        scope.toolCallId !== call.toolCallId ||
+        scope.serverName !== call.server ||
+        scope.rawToolName !== call.tool ||
+        !definition ||
+        closed
+      ) {
+        throw new Error('harness_mcp_connection_changed');
+      }
+      try {
+        const read = (uri: string, index: number, withinParent?: OperationResourceRead) =>
+          readResource(call, uri, index, withinParent);
+        const result = await input.dispatch(
+          call.server,
+          call.toolCallId,
+          call.tool,
+          structuredClone(call.arguments),
+          async (context) => {
+            const reply = await call.dispatch();
+            call.signal.throwIfAborted();
+            if (definition.image.status !== 'ordinary' && !reply.isError) {
+              const content = await resolveMcpContent(reply, (uri, index) => {
+                if (definition.image.status !== 'bound' || !context?.readResource) {
+                  throw new Error('harness_mcp_image_resource_import_unavailable');
+                }
+                return read(uri, index, context.readResource);
+              });
+              return { ...reply, content };
+            }
+            return reply;
+          },
+          definition.image.status === 'bound'
+        );
+        const content = await resolveMcpContent(result, (uri, index) => read(uri, index));
+        call.signal.throwIfAborted();
+        if (closed) throw new Error('harness_mcp_connection_changed');
+        return { content };
+      } catch (error) {
+        scope.failure = safeFailure(error);
+        throw scope.failure;
+      }
+    },
+  });
+
+  async function readResource(
+    call: HostManagedMcpToolCall,
+    uri: string,
+    index: number,
+    withinParent?: OperationResourceRead
+  ) {
+    call.signal.throwIfAborted();
+    if (!call.resourceReadAvailable) throw new Error('harness_mcp_resource_read_unavailable');
+    const toolCallId = createHash('sha256')
+      .update(JSON.stringify(['resource', call.toolCallId, index]))
+      .digest('hex');
+    const read = await scopes.run(
+      { toolCallId, serverName: call.server, rawToolName: call.tool, origin: 'resource' },
+      () => call.linkedResource(uri)
+    );
+    call.signal.throwIfAborted();
+    if (
+      closed ||
+      read.connectionId !== call.connectionId ||
+      read.parentToolCallId !== call.toolCallId ||
+      read.uri !== uri
+    ) {
+      throw new Error('harness_mcp_connection_changed');
+    }
+    return withinParent
+      ? withinParent(toolCallId, uri, () => read.dispatch())
+      : input.dispatch(call.server, toolCallId, 'resources/read', { uri }, () => read.dispatch());
+  }
+
+  function close(): Promise<void> {
+    if (closing) return closing;
+    closed = true;
+    lifetime.abort();
+    closing = (async () => {
+      await Promise.resolve();
+      const delivered = await Promise.all(
+        transports.map((transport) => transport.waitForCancellationDelivery())
+      );
+      try {
+        await adapter.close();
+      } finally {
+        events.clear();
+        definitions.clear();
+      }
+      if (delivered.some((outcome) => outcome === 'failed' || outcome === 'timed-out')) {
+        throw new Error('harness_mcp_cleanup_incomplete');
+      }
+    })();
+    return closing;
+  }
+
+  const preparation = AbortSignal.any([
+    ...(input.signal ? [input.signal] : []),
+    AbortSignal.timeout(30_000),
+  ]);
+  const abort = () => {
+    void close().catch(() => undefined);
+  };
+  preparation.addEventListener('abort', abort, { once: true });
+  try {
+    preparation.throwIfAborted();
+    await adapter.ready();
+    preparation.throwIfAborted();
+    const registration = {
+      events,
+      registerTool(tool: ToolDefinition) {
+        const definition = definitions.get(tool.name);
+        if (!definition) throw new Error('harness_mcp_tool_identity');
+        tools.push({
+          ...tool,
+          label: definition.label,
+          description: definition.description,
+          ...(definition.image.status === 'bound'
+            ? { parameters: definition.image.parameters }
+            : {}),
+          async execute(toolCallId, raw, signal, onUpdate, context) {
+            if (closed) throw new Error('harness_mcp_connection_changed');
+            const execution = AbortSignal.any([
+              lifetime.signal,
+              ...(signal ? [signal] : []),
+              AbortSignal.timeout(210_000),
+            ]);
+            const scope: Scope = {
+              toolCallId,
+              serverName: definition.serverName,
+              rawToolName: definition.rawToolName,
+              origin: 'direct',
+            };
+            try {
+              const args =
+                definition.image.status === 'bound'
+                  ? definition.image.map(raw)
+                  : structuredClone(raw);
+              if (!args || typeof args !== 'object' || Array.isArray(args))
+                throw new Error('harness_mcp_arguments_invalid');
+              const result = await scopes.run(scope, () =>
+                tool.execute(toolCallId, args, execution, onUpdate, context)
+              );
+              execution.throwIfAborted();
+              if (closed) throw new Error('harness_mcp_connection_changed');
+              if (scope.failure) throw scope.failure;
+              const error =
+                result.details && typeof result.details === 'object' && 'error' in result.details
+                  ? result.details.error
+                  : undefined;
+              if (error) {
+                throw new Error(
+                  error === 'catalog_changed'
+                    ? 'harness_mcp_schema_changed'
+                    : error === 'approval_denied' || error === 'approval_required'
+                      ? 'harness_permission_denied'
+                      : error === 'may_have_run' || error === 'invalid_result'
+                        ? 'harness_mcp_outcome_unknown'
+                        : 'harness_mcp_tool_failed'
+                );
+              }
+              return {
+                content: result.content,
+                details: {
+                  serverName: definition.serverName,
+                  toolName: definition.rawToolName,
+                  imageBinding: definition.image.status,
+                },
+              };
+            } catch (error) {
+              throw safeFailure(error, execution.aborted);
+            }
+          },
+        });
+      },
+    };
+    adapter.extensionFactory(
+      new Proxy(registration, {
+        get(target, property) {
+          if (!Reflect.has(target, property))
+            throw new Error('harness_mcp_registration_unsupported');
+          return Reflect.get(target, property);
+        },
+      }) as unknown as ExtensionAPI
+    );
+    return { tools, close };
+  } catch {
+    await close().catch(() => undefined);
+    throw new Error('harness_mcp_start_failed');
+  } finally {
+    preparation.removeEventListener('abort', abort);
+  }
+}
diff --git a/packages/harness-pi/src/mcp-tool-definition.ts b/packages/harness-pi/src/mcp-tool-definition.ts
