+        _meta: { mollyConnection: { id: 'images', revision: 3 }, mollyImageBinding: imageBinding },
+      },
+    ]);
+    control.bind({
+      version: 1,
+      runtimeEpoch: config.runtimeEpoch,
+      harness: config.harness,
+      toolsetHash: '0'.repeat(64),
+      pluginSetHash: '1'.repeat(64),
+      nativeSessionFile: join(root, 'synthetic.jsonl'),
+    });
+    const entered = deferred();
+    const release = deferred();
+    const approvals: Array<{ id: string; title: string | undefined; args: unknown }> = [];
+    const acceptedImports: unknown[] = [];
+    const client = new AgentClient({
+      sessionId,
+      logger,
+      terminalManager: {} as never,
+      agentConfig: { cliType: 'builtin', agentType: 'molly' },
+      onUpdateMessage: () => {},
+      onRequestPermission: async (_id, request) => {
+        approvals.push({
+          id: request.toolCall.toolCallId,
+          title: request.toolCall.title,
+          args: request.toolCall.rawInput,
+        });
+        return {
+          outcome: {
+            outcome: 'selected',
+            optionId:
+              mode === 'resource-denied' && request.toolCall.title === 'images/resources/read'
+                ? 'deny'
+                : 'allow',
+          },
+        };
+      },
+      onHarnessImageImport: (request) =>
+        control.importImages(request, async (ownedRequest, signal) => {
+          acceptedImports.push(ownedRequest);
+          entered.resolve();
+          await release.promise;
+          return importHarnessImages({
+            request: ownedRequest,
+            workspace,
+            artworkId,
+            operationDirectory: join(root, 'imports'),
+            signal,
+          });
+        }),
+    });
+    Reflect.set(client, 'acpSessionId', 'synthetic-acp');
+    const operationDirectory = join(root, 'operations');
+    const journal = new ToolOperationJournal(operationDirectory);
+    const server = new Server(
+      { name: 'synthetic-images', version: '1' },
+      { capabilities: { tools: {}, ...(mode === 'resource-unavailable' ? {} : { resources: {} }) } }
+    );
+    const wire: string[] = [];
+    const duringRead: unknown[] = [];
+    server.setRequestHandler(ListToolsRequestSchema, async () => ({
+      tools: [
+        {
+          name: 'draw',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              text: { type: 'string' },
+              model_id: { type: 'string', enum: ['synthetic-image'] },
+            },
+            required: ['text', 'model_id'],
+            additionalProperties: false,
+          },
+        },
+      ],
+    }));
+    server.setRequestHandler(CallToolRequestSchema, async (request) => {
+      wire.push(request.params.name);
+      expect(request.params.arguments).toEqual({
+        text: 'Synthetic image',
+        model_id: 'synthetic-image',
+      });
+      return {
+        content: [{ type: 'resource_link', uri: 'synthetic://image/one', name: 'image' }],
+        _meta: {
+          mollyImageOperation: { state: 'succeeded', assetDigests: ['f'.repeat(64)] },
+          forgedPath: '/foreign/server.png',
+        },
+      };
+    });
+    if (mode !== 'resource-unavailable')
+      server.setRequestHandler(ReadResourceRequestSchema, async () => {
+        wire.push('resources/read');
+        for (const file of await readdir(operationDirectory)) {
+          if (file.endsWith('.json'))
+            duringRead.push(JSON.parse(await readFile(join(operationDirectory, file), 'utf8')));
+        }
+        return {
+          contents: [
+            {
+              uri: mode === 'wrong-uri' ? 'synthetic://foreign' : 'synthetic://image/one',
+              mimeType: 'image/png',
+              blob: png,
+            },
+          ],
+        };
+      });
+    const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();
+    await server.connect(serverTransport);
+    let snapshot: HarnessRunSnapshot | undefined;
+    let importedRequest: ReturnType<typeof HarnessImageImportRequestSchema.parse> | undefined;
+    const bridge = await connectAdapterMcpServers(
+      { images: { imageBinding, createTransport: () => clientTransport } },
+      {
+        imageImportAvailable: true,
+        approve: async (request) => {
+          const answer = await client.requestPermission({
+            sessionId: 'synthetic-acp',
+            toolCall: {
+              toolCallId: request.toolCallId,
+              title: request.name,
+              rawInput: request.arguments,
+            },
+            options: [
+              { optionId: 'allow', kind: 'allow_once', name: 'Allow' },
+              { optionId: 'deny', kind: 'reject_once', name: 'Deny' },
+            ],
+          });
+          return answer.outcome.outcome === 'selected' && answer.outcome.optionId === 'allow';
+        },
+        dispatch: (serverName, toolCallId, toolName, args, invoke, boundImage) => {
+          const active = snapshot;
+          if (!active) throw new Error('synthetic_run_missing');
+          return journal.dispatch(
+            {
+              snapshot: active,
+              connectionId: 'images',
+              connectionRevision: 3,
+              toolCallId,
+              toolName,
+              arguments: args,
+              externalImage: boundImage,
+              importImages: boundImage
+                ? async (result) => {
+                    const content = await resolveMcpContent(result, async () => {
+                      throw new Error('unexpected_unresolved_resource');
+                    });
+                    importedRequest = HarnessImageImportRequestSchema.parse({
+                      version: 1,
+                      runId: active.runId,
+                      runtimeEpoch: mode === 'wrong-epoch' ? randomUUID() : active.runtimeEpoch,
+                      productSessionId: mode === 'wrong-session' ? randomUUID() : active.sessionId,
+                      turnId: active.turnId,
+                      connectionId: 'images',
+                      connectionRevision: 3,
+                      serverName,
+                      toolName,
+                      toolCallId,
+                      requestDigest: createHash('sha256')
+                        .update(JSON.stringify(args))
+                        .digest('hex'),
+                      images: content
+                        .filter((part) => part.type === 'image')
+                        .map((part) => ({ mimeType: part.mimeType, data: part.data })),
+                    });
+                    return HarnessImageImportResultSchema.parse(
+                      await client.extMethod(HARNESS_IMAGE_IMPORT_METHOD, {
+                        sessionId: 'synthetic-acp',
+                        request: importedRequest,
+                      })
+                    );
+                  }
+                : undefined,
+            },
+            invoke
+          );
+        },
+      }
+    );
+    const controller = new AbortController();
+    let toolResult: unknown;
+    let toolError: unknown;
+    const execution = control.prompt({
+      turnId: 'synthetic-turn',
+      signal: controller.signal,
+      prompt: async (active) => {
+        snapshot = active;
+        const tool = bridge.tools[0];
+        if (!tool) throw new Error('synthetic_tool_missing');
+        try {
+          toolResult = await tool.execute(
+            'synthetic-image-call',
+            { prompt: 'Synthetic image' },
+            controller.signal,
+            undefined,
+            {} as never
+          );
+        } catch (error) {
+          toolError = error;
+        }
+        return {
+          stopReason: 'end_turn',
+          _meta: {
+            mollyRunId: active.runId,
+            mollyRuntimeEpoch: active.runtimeEpoch,
+            mollyNativeOutcome: { status: 'completed', nativeEndEntryId: 'synthetic-leaf' },
+          },
+        };
+      },
+    });
+    const outcome = execution.then(
+      () => undefined,
+      (error) => error
+    );
+    try {
+      const [grant] = broker.exchange({
+        version: 1,
+        connections: [config.connection],
+        reports: [],
+      });
+      if (!grant) throw new Error('synthetic_grant_missing');
+      broker.exchange({
+        version: 1,
+        connections: [config.connection],
+        reports: [
+          {
+            requestId: grant.requestId,
+            runId: grant.snapshot.runId,
+            runtimeEpoch: config.runtimeEpoch,
+            connectionId: config.connection.id,
+            connectionRevision: config.connection.revision,
+            result: { ok: true, apiKey: 'SYNTHETIC_MODEL_KEY' },
+          },
+        ],
+      });
+      if (mode === 'imported' || mode === 'cancelled') {
+        await entered.promise;
+        if (!snapshot) throw new Error('synthetic_run_missing');
+        const parentPath = join(
+          operationDirectory,
+          `${journal.operationId(snapshot.runId, 'synthetic-image-call')}.json`
+        );
+        expect(JSON.parse(await readFile(parentPath, 'utf8'))).toMatchObject({
+          state: 'dispatched',
+          assetDigests: [],
+        });
+        expect(await readdir(workspace.artifactWorkdir)).toEqual([]);
+        if (mode === 'cancelled') controller.abort();
+        release.resolve();
+      }
+      await outcome;
+      if (!snapshot) throw new Error('synthetic_run_missing');
+      const parent = await journal.read(
+        journal.operationId(snapshot.runId, 'synthetic-image-call')
+      );
+      const childId = createHash('sha256')
+        .update(JSON.stringify(['resource', 'synthetic-image-call', 0]))
+        .digest('hex');
+      expect(approvals).toEqual([
+        {
+          id: 'synthetic-image-call',
+          title: 'images/draw',
+          args: { text: 'Synthetic image', model_id: 'synthetic-image' },
+        },
+        ...(mode === 'resource-unavailable'
+          ? []
+          : [
+              {
+                id: childId,
+                title: 'images/resources/read',
+                args: { uri: 'synthetic://image/one' },
+              },
+            ]),
+      ]);
+      expect(wire).toEqual(
+        ['resource-denied', 'resource-unavailable'].includes(mode)
+          ? ['draw']
+          : ['draw', 'resources/read']
+      );
+      if (!['resource-denied', 'resource-unavailable'].includes(mode))
+        expect(duringRead).toEqual(
+          expect.arrayContaining([
+            expect.objectContaining({ state: 'dispatched', toolName: 'draw' }),
+            expect.objectContaining({
+              state: 'dispatched',
+              toolName: 'resources/read',
+              parentOperationId: parent.operationId,
+            }),
+          ])
+        );
+      if (mode === 'imported') {
+        const digest = createHash('sha256').update(Buffer.from(png, 'base64')).digest('hex');
+        expect(toolError).toBeUndefined();
+        expect(parent).toMatchObject({ state: 'succeeded', assetDigests: [digest] });
+        expect(await readFile(join(workspace.artifactWorkdir, 'media', `${digest}.png`))).toEqual(
+          Buffer.from(png, 'base64')
+        );
+        expect(await readdir(workspace.artifactWorkdir)).toEqual(['media']);
+        expect(JSON.stringify(toolResult)).not.toContain(png);
+        expect(JSON.stringify(toolResult)).not.toContain('/foreign/server.png');
+        expect(JSON.stringify(toolResult)).toContain(digest);
+        await expect(
+          client.extMethod(HARNESS_IMAGE_IMPORT_METHOD, {
+            sessionId: 'synthetic-acp',
+            request: importedRequest,
+          })
+        ).rejects.toThrow('harness_image_import_refused');
+      } else {
+        expect(toolError).toBeInstanceOf(Error);
+        expect(parent).toMatchObject({ state: 'outcome_unknown', assetDigests: [] });
+        expect(await readdir(workspace.artifactWorkdir)).toEqual([]);
+      }
+      expect(acceptedImports.length > 0).toBe(mode === 'imported' || mode === 'cancelled');
+    } finally {
+      release.resolve();
+      await bridge.close();
+      await server.close();
+      broker.dispose();
+      pipe.destroy();
+    }
+  }
+);
diff --git a/packages/harness-pi/src/mcp-adapter.ts b/packages/harness-pi/src/mcp-adapter.ts
