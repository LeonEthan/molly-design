+    });
+    await mkdir(workspace.artifactWorkdir, { recursive: true });
+    const imageBinding = McpImageBindingSchema.parse({
+      version: 1,
+      model: 'synthetic-image',
+      generate: { tool: 'draw', fields: { prompt: 'text', model: 'model_id' } },
+    });
+    const config: WorkerConfig = {
+      schemaVersion: 1,
+      runtimeEpoch: randomUUID(),
+      productSessionId: sessionId,
+      workspaceId: 'synthetic-workspace',
+      privateRoot: join(root, 'private'),
+      designImageImport: true,
+      cwd: root,
+      shellPath: '/bin/sh',
+      connection: {
+        schemaVersion: 1,
+        id: 'synthetic-model',
+        revision: 1,
+        providerPresetId: 'openai',
+        displayName: 'Synthetic',
+        baseUrl: 'https://synthetic.invalid/v1',
+        credentialRef: 'synthetic-ref',
+        enabled: true,
+      },
+      selection: { connectionId: 'synthetic-model', modelId: 'synthetic', thinking: 'off' },
+      systemPrompt: 'Synthetic',
+      permissionProfileId: 'ask',
