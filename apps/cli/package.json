{
  "name": "molly",
  "private": true,
  "version": "0.1.0",
  "description": "Molly embedded Agent runtime",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "pnpm run prepare:acp-adapters && pnpm run prepare:design-authoring && node scripts/dev-build.mjs --clean && node --enable-source-maps dist-dev/index.js",
    "dev:build": "node scripts/dev-build.mjs --clean",
    "build": "pnpm run clean && pnpm run prepare:acp-adapters && pnpm run prepare:design-authoring && pnpm run typecheck && pnpm run build:bundle && pnpm run copy:design-skills && pnpm run check:published-bundle-imports && pnpm run copy:wasm",
    "build:watch": "vite build --watch",
    "build:bundle": "vite build && node scripts/build-embedded-harness.mjs",
    "prepare:acp-adapters": "corepack pnpm --dir ../.. --filter acp-extension-core build",
    "prepare:design-authoring": "corepack pnpm --dir ../.. --filter @molly/design-authoring build",
    "check:published-bundle-imports": "node scripts/check-published-bundle-imports.js",
    "copy:design-skills": "node scripts/copy-design-skills.js",
    "copy:wasm": "node scripts/copy-loro-wasm.js",
    "clean": "rimraf dist dist-dev",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:packaging": "node --test scripts/legacy-artifacts.test.mjs",
    "bench:acp-history": "vitest bench tests/acp-history.bench.ts",
    "bench:turn-diff-store": "pnpm --filter @molly/turn-diff-store bench",
    "test:e2e": "MOLLY_E2E=1 vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "cli",
    "typescript",
    "command-line",
    "agent",
    "local-execution"
  ],
  "author": "Molly contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0 <23 || >=23.6.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@molly/design-authoring": "workspace:*",
    "@molly/harness-pi": "workspace:*",
    "@molly/cli-supervisor": "workspace:*",
    "@molly/platform": "workspace:*",
    "@molly/shared": "workspace:*",
    "@molly/turn-diff-store": "workspace:*",
    "@loro-dev/flock-wasm": "catalog:",
    "@loro-dev/streams-crdt": "catalog:",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/better-sqlite3": "catalog:",
    "@types/cross-spawn": "^6.0.6",
    "@types/diff": "^7.0.0",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "catalog:",
    "@types/proxy-from-env": "^1.0.4",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "acp-extension-core": "workspace:*",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "diff": "^7.0.0",
    "effect": "catalog:",
    "esbuild": "^0.24.2",
    "eventemitter3": "^5.0.1",
    "globby": "^16.1.0",
    "https-proxy-agent": "^7.0.6",
    "iconv-lite": "^0.6.3",
    "inquirer": "^10.2.2",
    "isbinaryfile": "^6.0.0",
    "jiti": "^2.6.1",
    "loro-mirror": "catalog:",
    "loro-repo": "catalog:",
    "ora": "^8.2.0",
    "prettier": "^3.6.2",
    "proxy-from-env": "^1.1.0",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.5",
    "undici": "catalog:",
    "uuid": "^13.0.0",
    "vite": "catalog:",
    "vite-plugin-top-level-await": "catalog:",
    "vite-plugin-wasm": "catalog:",
    "vitest": "^3.2.4",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.7.1",
    "ws": "^8.18.3",
    "zod": "catalog:"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "better-sqlite3": "catalog:",
    "loro-crdt": "1.15.1",
    "shell-env": "^4.0.3",
    "sharp": "0.35.4",
    "smol-toml": "1.6.1",
    "tinypool": "^1.0.0",
    "typescript": "^5.9.3"
  }
}
