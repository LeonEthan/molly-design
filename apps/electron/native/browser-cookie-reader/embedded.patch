+#[cfg(target_os = "macos")]
+#[test]
+fn explicit_path_extraction_keeps_row_failures_as_warnings() {
+  use crate::browser::chromium_crypto::ChromiumKeyOutcomes;
+  let dir = crate::utils::TempDir::new().expect("temp dir");
+  let db = dir.path().join("Cookies");
+  seed_chromium_db(&db, "good", "fixture", &[]);
+  let connection = rusqlite::Connection::open(&db).expect("reopen fixture");
+  for name in ["broken-one", "broken-two"] {
+    connection
+      .execute(
+        "INSERT INTO cookies VALUES ('.example.test', '/', 0, 0, ?1, '', ?2, 0, 0)",
+        rusqlite::params![name, b"v10not-a-valid-ciphertext".as_slice()],
+      )
+      .expect("insert undecryptable cookie");
+  }
+  drop(connection);
+  let clock = crate::common::deadline::SystemClock;
+  let runtime = crate::common::deadline::BoundaryRuntime::standard(&clock);
+  let (cookies, warnings) =
+    crate::browser::chromium_projection::extract_detailed_cookies_with_key_outcomes_and_warnings(
+      ChromiumKeyOutcomes::provider_failure("synthetic key lookup failure"),
+      db,
+      None,
+      false,
+      &runtime,
+    )
+    .expect("partial extraction");
+  assert_eq!(cookies.len(), 1);
+  let mut recorded = std::collections::BTreeMap::new();
+  for (code, count) in warnings.into_entries() {
+    recorded.insert(format!("{code:?}"), count);
+  }
+  assert_eq!(recorded.get("DecryptFailed"), Some(&2), "{recorded:?}");
+}
