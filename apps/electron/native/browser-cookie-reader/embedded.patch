+  let mut malformed = cookie("bad-host", None);
+  malformed.cookie.domain = "".to_owned();
+  let (rows, omitted) = filter_molly_inventory_at(vec![cookie("valid", None), malformed], true, epoch(1_000)).unwrap();
+  assert_eq!(rows.len(), 1);
+  assert_eq!(omitted.malformed_host_identity, 1);
+  assert!(filter_molly_inventory_at(vec![cookie("lossy", Some(1u64 << 53))], true, epoch(1_000)).is_err());
+  assert!(filter_molly_inventory_at(vec![cookie("lossy", Some(u64::MAX))], true, epoch(1_000)).is_err());
+}
+
+#[test]
+fn molly_inventory_retains_session_and_expiry_policy_without_normalizing_partitions() {
+  let rows = vec![cookie("expired", Some(999)), cookie("session", None), cookie("future", Some(1_001))];
+  let (all, _) = filter_molly_inventory_at(rows.clone(), true, epoch(1_000)).unwrap();
+  assert_eq!(all, rows);
+  let (current, _) = filter_molly_inventory_at(rows, false, epoch(1_000)).unwrap();
+  assert_eq!(current.iter().map(|row| row.cookie.name.as_str()).collect::<Vec<_>>(), vec!["session", "future"]);
+}
+
+#[test]
+fn molly_inventory_is_opt_in_for_explicit_paths() {
+  assert!(!FromPathRequest::new("Cookies").molly_inventory);
+  assert!(FromPathRequest::new("Cookies").molly_inventory(true).molly_inventory);
+}
