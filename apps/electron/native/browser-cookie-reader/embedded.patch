+fn filter_molly_inventory_at(
+  cookies: Vec<DetailedCookie>,
+  include_expired: bool,
+  now: SystemTime,
+) -> anyhow::Result<(Vec<DetailedCookie>, OmittedRows)> {
+  let now = unix_seconds(now)?;
+  let mut omitted = OmittedRows::default();
+  let mut kept = Vec::with_capacity(cookies.len());
+  for detailed in cookies {
+    let cookie = &detailed.cookie;
+    if !crate::browser::cookie_record::host_identity_survives(&cookie.domain) {
+      omitted.malformed_host_identity += 1;
+      continue;
+    }
+    if cookie.expires.is_some_and(|expires| expires > (1u64 << 53) - 1) {
+      anyhow::bail!("Molly inventory cannot represent the cookie expiration exactly");
+    }
+    if !include_expired && cookie.expires.is_some_and(|expires| expires <= now) {
+      continue;
+    }
+    kept.push(detailed);
+  }
+  Ok((kept, omitted))
