+#[test]
+fn molly_inventory_retains_raw_rows_before_main_selection() {
+  let mut opaque = cookie("partitioned", None);
+  opaque.context.top_frame_site_key = Some("opaque".to_owned());
+  let rows = vec![cookie("valid", None), cookie("invalid name", None), opaque];
+  let (snapshot_rows, snapshot_omissions) = filter_snapshot_at(rows.clone(), true, epoch(1_000)).unwrap();
+  assert_eq!(snapshot_rows.len(), 2);
+  assert_eq!(snapshot_omissions.invalid_octets, 1);
+  assert_eq!(snapshot_omissions.unparsable_partition_key, 1);
+  let (inventory, omissions) = filter_molly_inventory_at(rows.clone(), true, epoch(1_000)).unwrap();
+  assert_eq!(inventory, rows);
+  assert_eq!(omissions, OmittedRows::default());
+  assert!(!ReadRequest::browser("chrome").molly_inventory);
+  assert!(ReadRequest::browser("chrome").molly_inventory(true).molly_inventory);
+}
+
+#[test]
+fn molly_inventory_keeps_host_failures_and_rejects_lossy_expiry() {
+  let mut malformed = cookie("bad-host", None);
+  malformed.cookie.domain = "".to_owned();
+  let (rows, omitted) = filter_molly_inventory_at(vec![cookie("valid", None), malformed], true, epoch(1_000)).unwrap();
+  assert_eq!(rows.len(), 1);
+  assert_eq!(omitted.malformed_host_identity, 1);
+  assert!(filter_molly_inventory_at(vec![cookie("lossy", Some(1u64 << 53))], true, epoch(1_000)).is_err());
+  assert!(filter_molly_inventory_at(vec![cookie("lossy", Some(u64::MAX))], true, epoch(1_000)).is_err());
+}
