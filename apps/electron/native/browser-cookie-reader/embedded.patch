+    let temp = TempDir::new("molly-profile-access-denial");
+    let real_context = current_context(temp.path().to_path_buf());
+    let root = channel_root(&real_context, "stable");
+    std::fs::create_dir_all(&root).expect("create synthetic root");
+    let canonical_root = root.canonicalize().expect("canonical root");
+    let context = with_test_fs(real_context, TestDiscoveryFs {
+      denied_read_dir_errno: Some((canonical_root, errno)),
+      ..TestDiscoveryFs::default()
+    });
+    let discovery = discover_browser_with_context(&context, "chrome").unwrap();
+    let error = crate::error::map_job_error(profiles_for_listing("chrome", discovery).unwrap_err());
+    assert_eq!(error.code(), if errno == 1 { "molly_source_access_denied" } else { "engine_failure" });
+  }
+}
