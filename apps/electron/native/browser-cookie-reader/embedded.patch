+#[test]
+fn molly_inventory_retains_session_and_expiry_policy_without_normalizing_partitions() {
+  let rows = vec![cookie("expired", Some(999)), cookie("session", None), cookie("future", Some(1_001))];
+  let (all, _) = filter_molly_inventory_at(rows.clone(), true, epoch(1_000)).unwrap();
+  assert_eq!(all, rows);
+  let (current, _) = filter_molly_inventory_at(rows, false, epoch(1_000)).unwrap();
+  assert_eq!(current.iter().map(|row| row.cookie.name.as_str()).collect::<Vec<_>>(), vec!["session", "future"]);
