+use anyhow::{bail, Context, Result};
+use crate::common::deadline::BoundaryRuntime;
+use crate::common::secret::{SecretBytes, SecretString};
+use std::{ffi::c_void, ptr};
+use zeroize::Zeroize;
+
+#[derive(Debug)]
+pub(crate) struct KeychainAuthorizationDenied;
+
+impl std::fmt::Display for KeychainAuthorizationDenied {
+  fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+    formatter.write_str("macOS Keychain authorization denied")
+  }
+}
+
+impl std::error::Error for KeychainAuthorizationDenied {}
+
+fn check_keychain_status(status: i32) -> Result<()> {
+  match status {
+    0 => Ok(()),
+    -128 | -25293 => Err(KeychainAuthorizationDenied.into()),
+    _ => bail!("macOS Keychain lookup failed (OSStatus {status})"),
+  }
+}
+
+#[link(name = "Security", kind = "framework")]
+unsafe extern "C" {
+  fn SecKeychainFindGenericPassword(
+    keychain: *const c_void, service_len: u32, service: *const u8,
+    account_len: u32, account: *const u8, password_len: *mut u32,
+    password: *mut *mut c_void, item: *mut *mut c_void,
+  ) -> i32;
+  fn SecKeychainItemFreeContent(attributes: *mut c_void, data: *mut c_void) -> i32;
+}
+
+struct KeychainContent { bytes: *mut c_void, len: u32 }
+
+impl Drop for KeychainContent {
+  fn drop(&mut self) {
+    if !self.bytes.is_null() {
+      // SAFETY: Security.framework owns this allocation until FreeContent; see Apple's SecKeychainFindGenericPassword contract.
+      unsafe {
+        std::slice::from_raw_parts_mut(self.bytes.cast::<u8>(), self.len as usize).zeroize();
+        SecKeychainItemFreeContent(ptr::null_mut(), self.bytes);
+      }
+    }
+  }
+}
+
+pub(crate) fn get_osx_keychain_password_with_runtime(
+  service: &str, account: &str, runtime: &BoundaryRuntime<'_>,
+) -> Result<SecretString> {
+  runtime.check()?;
+  let mut content = KeychainContent { bytes: ptr::null_mut(), len: 0 };
+  // SAFETY: length-delimited UTF-8 inputs and initialized output pointers follow Apple's SecKeychainFindGenericPassword contract.
+  let status = unsafe { SecKeychainFindGenericPassword(
+    ptr::null(), service.len().try_into()?, service.as_ptr(),
+    account.len().try_into()?, account.as_ptr(), &mut content.len,
+    &mut content.bytes, ptr::null_mut(),
+  ) };
+  runtime.check()?;
+  check_keychain_status(status)?;
+  if content.bytes.is_null() || content.len == 0 || content.len > 4096 {
+    bail!("macOS Keychain returned an unsupported credential");
+  }
+  // SAFETY: Security.framework returned a non-null allocation of content.len bytes, owned by the guard above.
+  let secret = SecretBytes::new(unsafe {
+    std::slice::from_raw_parts(content.bytes.cast::<u8>(), content.len as usize).to_vec()
+  });
+  secret.into_secret_string().context("macOS Keychain credential is not UTF-8")
+}
+
+#[cfg(test)]
+mod tests {
+  use super::*;
+
+  #[test]
+  fn molly_keychain_status_classifies_only_explicit_denial_or_user_cancellation() {
+    assert!(check_keychain_status(0).is_ok());
+    for status in [-128, -25293] {
+      assert!(check_keychain_status(status).unwrap_err().is::<KeychainAuthorizationDenied>());
+    }
+    for status in [-25300, -25308, -25291] {
+      assert!(!check_keychain_status(status).unwrap_err().is::<KeychainAuthorizationDenied>());
+    }
+  }
+}
