{
  "name": "@molly/code-review-viewer",
  "private": true,
  "version": "0.76.0",
  "description": "Self-contained single-file HTML viewer for Molly code reviews, fetched on demand by `molly review`.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "standalone.html"
  ],
  "exports": {
    "./manifest": {
      "types": "./src/manifest.d.ts",
      "import": "./dist/manifest.generated.ts"
    },
    "./standalone.html": "./standalone.html"
  },
  "scripts": {
    "build": "pnpm --filter @molly/code-review-helper build:standalone && node scripts/build-viewer.mjs",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
