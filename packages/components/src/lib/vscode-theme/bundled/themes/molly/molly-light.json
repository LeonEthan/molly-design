      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#59873a"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type.class.jsdoc",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#6B7CDB"
      }
    },
    {
