      "settings": {
        "foreground": "#99841877"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#998418"
      }
    },
    {
      "scope": [
        "property",
        "meta.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "attribute.name"
      ],
      "settings": {
        "foreground": "#998418"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
