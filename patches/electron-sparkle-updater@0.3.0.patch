+static void NotifySparkleInstallCycleEnded(NSError * _Nullable error) {
+  if (g_userDriver == nil || !g_userDriver.installAttemptActive) return;
+  [g_userDriver retireCheckCancellation];
+  g_userDriver.installWhenReady = NO;
+  g_userDriver.installAttemptActive = NO;
+  g_userDriver.readyToInstallReply = nil;
+  if (error != nil) {
+    NSString *message = error.localizedDescription.length > 0 ? error.localizedDescription : @"sparkle_error";
+    EmitSparkleEvent(@{@"type" : @"error", @"message" : message});
+  } else {
+    EmitSparkleEvent(@{@"type" : @"install-cancelled"});
+  }
+}
